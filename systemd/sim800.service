[Unit]
Description=SIM800 PPP Connection (pppd call sim800)
After=dev-ttyS5.device
Requires=dev-ttyS5.device

[Service]
Type=forking
ExecStart=/usr/sbin/pppd call sim800
Restart=always
RestartSec=5
# Avoid systemd giving up after repeated failures
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
