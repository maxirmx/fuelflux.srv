[Unit]
Description=AutoSSH tunnel to kreel0
After=sim800.service
Requires=sim800.service
BindsTo=sim800.service
PartOf=sim800.service

[Service]
Type=simple
User=root

Environment=AUTOSSH_GATETIME=0
Environment=AUTOSSH_MAXSTART=1024
Environment=AUTOSSH_POLL=10

# Wait only for IP, not connectivity (max 30s to avoid blocking startup forever)
ExecStartPre=/usr/bin/bash -c 'for i in {1..30}; do ip -4 addr show ppp0 | grep -q inet && exit 0; sleep 1; done; echo "ppp0 has no IP" >&2; exit 1'

ExecStart=/usr/bin/autossh -M 0 -N \
  -o BindInterface=ppp0 \
  -o ConnectTimeout=10 \
  -o ServerAliveInterval=20 \
  -o ServerAliveCountMax=3 \
  -o TCPKeepAlive=yes \
  -o ExitOnForwardFailure=yes \
  -o StrictHostKeyChecking=accept-new \
  -R @REMOTE_PORT@:localhost:@LOCAL_PORT@ \
  @SSH_USERHOST@

Restart=always
RestartSec=10
StartLimitIntervalSec=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=autossh-ppp

[Install]
WantedBy=multi-user.target
